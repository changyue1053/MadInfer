{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mad.example/infer/manifest.v1.json",
  "title": "infer manifest.v1（算法包）",
  "description": "算法包清单（设计文档 §5.3 P3）。manifest 是唯一被签名的对象：对去掉 signature 后的文档做 JCS（RFC 8785）规范化后 ed25519 签名；blob 以 sha256 被引用，签名因此覆盖全部内容。",
  "type": "object",
  "required": ["schema", "name", "version", "capability", "kind", "compat", "blobs", "issued_at", "signature"],
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "capability": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "kind": { "enum": ["generate", "task", "pipeline"] },
    "business_scope": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 }, "description": "允许使用的业务；空 = 全部" },
    "compat": {
      "type": "object",
      "required": ["min_sdk", "memory_mb", "tiers"],
      "properties": {
        "min_sdk": { "type": "string" },
        "engines": { "type": "object", "additionalProperties": { "type": "string" }, "description": "内联引擎版本要求；系统模型无此项" },
        "formats": { "type": "array", "items": { "enum": ["gguf", "onnx", "tflite", "coreml", "mnn"] } },
        "quant": { "type": "array", "items": { "type": "string" } },
        "opset": { "type": ["integer", "null"] },
        "memory_mb": { "type": "integer", "minimum": 1 },
        "tiers": { "type": "array", "minItems": 1, "items": { "enum": ["low", "mid", "flagship"] } },
        "min_os": { "type": "object", "properties": { "ios": { "type": "string" }, "android": { "type": "string" }, "ohos": { "type": "string" } } }
      }
    },
    "blobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "size", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["base_weights", "adapter", "tokenizer", "prompt_template", "json_schema", "grammar", "eval_set", "aux"] },
          "shared": { "type": "boolean" },
          "url": { "type": "string", "format": "uri" },
          "enc": {
            "type": "object",
            "required": ["alg", "key_id", "nonce", "plain_sha256"],
            "properties": {
              "alg": { "enum": ["aes-256-gcm"] },
              "key_id": { "type": "string" },
              "nonce": { "type": "string" },
              "plain_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "base": { "$ref": "#/$defs/sha256" },
        "adapter": { "$ref": "#/$defs/sha256" },
        "tokenizer": { "$ref": "#/$defs/sha256" },
        "ctx": { "type": "integer", "minimum": 1 },
        "kv_quant": { "type": "string" },
        "io": {
          "type": "object",
          "description": "kind = task 时必填",
          "properties": {
            "inputs": { "type": "array", "items": { "$ref": "#/$defs/tensor_spec" } },
            "outputs": { "type": "array", "items": { "$ref": "#/$defs/tensor_spec" } }
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "properties": {
        "template": { "$ref": "#/$defs/sha256" },
        "system_prefix_cacheable": { "type": "boolean" },
        "token_budget": { "type": "integer", "minimum": 1 },
        "chunking": {
          "type": "object",
          "properties": {
            "strategy": { "enum": ["none", "truncate_head", "truncate_tail", "map_reduce"] },
            "chunk_tokens": { "type": "integer", "minimum": 1 },
            "overlap": { "type": "integer", "minimum": 0 },
            "reduce_template": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": { "$ref": "#/$defs/sha256" },
        "constraint": { "enum": ["prefer_native", "emulate", "none"] },
        "validate": { "enum": ["strict", "lenient"] }
      }
    },
    "postproc": {
      "type": "object",
      "description": "kind = task 时出现",
      "properties": {
        "kind": { "enum": ["labels", "embedding", "tensors"] },
        "labels_ref": { "$ref": "#/$defs/sha256" }
      }
    },
    "sampling": {
      "type": "object",
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "stop": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
        "allow_override": {
          "type": "object",
          "additionalProperties": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
          "description": "请求 options 只能落在这些区间内"
        }
      }
    },
    "steps": {
      "type": "array",
      "description": "kind = pipeline 时出现；每步引用已安装的其他包",
      "items": {
        "type": "object",
        "required": ["capability", "input_from", "output_to"],
        "properties": { "capability": { "type": "string" }, "input_from": { "type": "string" }, "output_to": { "type": "string" } }
      }
    },
    "eval": {
      "type": "object",
      "properties": {
        "set": { "$ref": "#/$defs/sha256" },
        "thresholds": {
          "type": "object",
          "properties": {
            "quality_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "schema_valid_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "ref_exist_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "ttft_p95_ms": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "peak_memory_mb": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "supersedes": { "type": ["string", "null"] },
    "issued_at": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tensor_spec": {
      "type": "object",
      "required": ["name", "dtype", "dims"],
      "properties": {
        "name": { "type": "string" },
        "dtype": { "enum": ["f32", "f16", "i8", "u8", "i32", "i64"] },
        "dims": { "type": "array", "items": { "type": "integer", "minimum": -1 } }
      }
    },
    "signature": {
      "type": "object",
      "required": ["alg", "key_id", "sig"],
      "properties": {
        "alg": { "enum": ["ed25519"] },
        "key_id": { "type": "string" },
        "sig": { "type": "string", "description": "base64" }
      }
    }
  }
}
